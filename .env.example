# Local-First Automated PRD Engineering Framework Environment Variables

# API & Security
SECRET_KEY=local-prd-framework-secret-key-production-ready-9999
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=prd_framework

# AI Provider Selection ("groq" or "ollama")
AI_PROVIDER=groq
AI_TIMEOUT_SECONDS=180

# Groq API Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b

# Local AI Engine (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_MODEL=llama3.2
FALLBACK_MODEL=mistral
USE_OFFLINE_MOCK_IF_OLLAMA_DOWN=false

# Storage
DATA_DIR=data
